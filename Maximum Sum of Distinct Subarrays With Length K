class Solution(object):
    def maximumSubarraySum(self, nums, k):
        max_sum = 0
        current_sum = 0
        counts = {}
        for i in range(k):
            current_sum += nums[i]
            counts[nums[i]] = counts.get(nums[i], 0) + 1
        if len(counts) == k:
            max_sum = current_sum
        for i in range(k, len(nums)):
            out_elem = nums[i - k]
            current_sum -= out_elem
            counts[out_elem] -= 1
            if counts[out_elem] == 0:
                del counts[out_elem]
            in_elem = nums[i]
            current_sum += in_elem
            counts[in_elem] = counts.get(in_elem, 0) + 1
            if len(counts) == k:
                max_sum = max(max_sum, current_sum)
        return max_sum
